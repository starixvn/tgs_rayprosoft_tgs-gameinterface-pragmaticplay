<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.11</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-pragmaticplay</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-pragmaticplay.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameInterface.PragmaticPlay.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.PragmaticPlay.Client</PackageId>
		<Title>Tgs.GameInterface.PragmaticPlay.Client</Title>
		<Description>Tgs.GameInterface.PragmaticPlay.Client</Description>
		<PackageTags>Tgs GameInterface PragmaticPlay Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.62.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.62.0" />
		<PackageReference Include="Grpc.Tools" Version="2.62.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameInterface.PragmaticPlay\Protos\gameinterfacepragmaticplay.proto">
	    <Link>gameinterfacepragmaticplay.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
